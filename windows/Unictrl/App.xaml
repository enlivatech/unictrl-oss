<Application
    x:Class="Unictrl.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Unictrl pine (#0B5550 -> #26957F) as the accent, so switches and buttons match the icon. -->
            <Color x:Key="SystemAccentColor">#26957F</Color>
            <Color x:Key="SystemAccentColorLight1">#2FA58C</Color>
            <Color x:Key="SystemAccentColorLight2">#4DBDA6</Color>
            <Color x:Key="SystemAccentColorLight3">#7FD6C2</Color>
            <Color x:Key="SystemAccentColorDark1">#1C7A69</Color>
            <Color x:Key="SystemAccentColorDark2">#135F52</Color>
            <Color x:Key="SystemAccentColorDark3">#0B5550</Color>
            <LinearGradientBrush x:Key="PineGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B5550" Offset="0" />
                <GradientStop Color="#26957F" Offset="1" />
            </LinearGradientBrush>
            <!-- Connected screens the pointer is not on: a lighter pine, so they still read as connected. -->
            <LinearGradientBrush x:Key="PineLightGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5DB7A1" Offset="0" />
                <GradientStop Color="#8DD1BF" Offset="1" />
            </LinearGradientBrush>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="62" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,16,0,6" />
            </Style>
            <Style x:Key="CardIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Margin" Value="4,0,18,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
